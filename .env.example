# Copy to .env.local and fill in real values. Never commit secrets.
# The standalone repolens-agent has its own rollback-only environment file.

# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Supabase (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Gemini classification, explanations, and Ask (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Keep tracing disabled for the zero-cost deployment.
LANGSMITH_TRACING=false

# Rollback credential signing secret (any long random string)
REPOLENS_AGENT_CREDENTIAL_SECRET=
