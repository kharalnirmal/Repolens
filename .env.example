# Copy to .env.local and fill in real values. Never commit secrets.
# See repolens-agent/.env for the agent's own variables.

# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Supabase (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Gemini explanations (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# LangSmith tracing (https://smith.langchain.com). Only needed when tracing.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=repolens

# Analysis credential signing secret (any long random string)
REPOLENS_AGENT_CREDENTIAL_SECRET=

# URL of the deployed repolens-agent (e.g. http://localhost:2024 for `mda dev`)
REPOLENS_AGENT_URL=
